generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// Login throttle storage (TAH-19, interface-contract §4.1). Postgres-backed,
// not in-process memory, so the counters survive restarts and are shared
// across Railway instances. Each row is one *failed* login attempt; a
// successful login deletes the rows for that ip/email.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}
